rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function myself(uid) { return signedIn() && request.auth.uid == uid; }
    function group(gid) { return get(/databases/$(database)/documents/groups/$(gid)); }
    function friends(uid1, uid2) {
      return exists(/databases/$(database)/documents/users/$(uid1)/friends/$(uid2))
        && exists(/databases/$(database)/documents/users/$(uid2)/friends/$(uid1));
    }
    function member(gid) {
      return verified() && request.auth.uid in group(gid).data.memberIds;
    }
    function admin(gid) {
      return verified() && request.auth.uid in group(gid).data.adminIds;
    }
    function validMessage() {
      return request.resource.data.keys().hasOnly([
          'senderId','senderName','type','text','createdAt','lat','lng'])
        && request.resource.data.keys().hasAll([
          'senderId','senderName','type','text','createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time
        && ( (request.resource.data.type == 'text'
                && request.resource.data.keys().hasOnly(['senderId','senderName','type','text','createdAt'])
                && request.resource.data.text.size() > 0)
          || (request.resource.data.type == 'location'
                && request.resource.data.keys().hasAll(['lat','lng'])
                && request.resource.data.lat is number
                && request.resource.data.lng is number
                && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
                && request.resource.data.lng >= -180 && request.resource.data.lng <= 180)
        );
    }

    match /users/{uid} {
      allow get: if myself(uid);
      allow list: if false;
      allow create: if myself(uid)
        && request.auth.token.email != null
        && request.resource.data.keys().hasAll([
          'displayName','email','phone','phoneVerified','countryCode','createdAt'])
        && request.resource.data.keys().hasOnly([
          'displayName','email','phone','phoneVerified','countryCode','createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.countryCode is string
        && request.resource.data.phoneVerified == false
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /fcm_tokens/{tokenId} {
        allow read, delete: if verified() && myself(uid);
        allow create, update: if verified() && myself(uid)
          && request.resource.data.keys().hasOnly(['token','updatedAt'])
          && request.resource.data.keys().hasAll(['token','updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.updatedAt == request.time;
      }

      match /ai_conversations/{conversationId} {
        allow get, list, delete: if verified() && myself(uid);
        allow create: if verified() && myself(uid)
          && request.resource.data.keys().hasOnly(['title','preview','updatedAt'])
          && request.resource.data.keys().hasAll(['title','preview','updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 60
          && request.resource.data.preview is string
          && request.resource.data.preview.size() <= 4000
          && request.resource.data.updatedAt == request.time;
        allow update: if verified() && myself(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preview','updatedAt'])
          && request.resource.data.preview is string
          && request.resource.data.preview.size() <= 4000
          && request.resource.data.updatedAt == request.time;

        match /messages/{messageId} {
          allow get, list, delete: if verified() && myself(uid);
          allow create: if verified() && myself(uid)
            && request.resource.data.keys().hasOnly(['text','isUser','fromAi','sos','createdAt'])
            && request.resource.data.keys().hasAll(['text','isUser','fromAi','sos','createdAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 4000
            && request.resource.data.isUser is bool
            && request.resource.data.fromAi is bool
            && request.resource.data.sos is bool
            && request.resource.data.createdAt is timestamp;
          allow update: if false;
        }
      }

      match /friends/{friendUid} {
        allow get, list: if verified() && myself(uid);
        allow create: if verified()
          && request.resource.data.keys().hasOnly(['name','createdAt','rid'])
          && request.resource.data.keys().hasAll(['name','createdAt','rid'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.createdAt == request.time
          && request.resource.data.rid is string
          && existsAfter(/databases/$(database)/documents/friend_requests/$(request.resource.data.rid))
          && getAfter(/databases/$(database)/documents/friend_requests/$(request.resource.data.rid)).data.status == 'accepted'
          && ((getAfter(/databases/$(database)/documents/friend_requests/$(request.resource.data.rid)).data.fromUid == uid
                && getAfter(/databases/$(database)/documents/friend_requests/$(request.resource.data.rid)).data.toUid == friendUid)
              || (getAfter(/databases/$(database)/documents/friend_requests/$(request.resource.data.rid)).data.toUid == uid
                && getAfter(/databases/$(database)/documents/friend_requests/$(request.resource.data.rid)).data.fromUid == friendUid))
          && request.auth.uid in [uid, friendUid];
        allow delete: if verified() && (myself(uid) || myself(friendUid));
        allow update: if false;
      }
    }

    match /friend_codes/{code} {
      allow get: if verified();
      allow list: if verified() && resource.data.uid == request.auth.uid;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['uid','displayName','createdAt'])
        && request.resource.data.keys().hasAll(['uid','displayName','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /friend_requests/{rid} {
      allow get, list: if verified()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['fromUid','fromName','toUid','toName','status','createdAt'])
        && request.resource.data.keys().hasAll(['fromUid','fromName','toUid','toName','status','createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 120
        && request.resource.data.toName is string
        && request.resource.data.toName.size() <= 120
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if verified()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if verified()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    function directChatPath(chatId) {
      return /databases/$(database)/documents/direct_chats/$(chatId);
    }
    function directMessagePath(chatId, messageId) {
      return /databases/$(database)/documents/direct_chats/$(chatId)/messages/$(messageId);
    }
    function canAccessDirectChat(chatId) {
      let chat = get(directChatPath(chatId)).data;
      return verified()
        && chat.participantIds is list
        && chat.participantIds.size() == 2
        && request.auth.uid in chat.participantIds
        && friends(chat.participantIds[0], chat.participantIds[1]);
    }

    match /direct_chats/{chatId} {
      allow get: if canAccessDirectChat(chatId);
      allow list: if false;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['participantIds','createdAt'])
        && request.resource.data.keys().hasAll(['participantIds','createdAt'])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && chatId == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && friends(request.resource.data.participantIds[0], request.resource.data.participantIds[1])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if canAccessDirectChat(chatId);
        allow create: if canAccessDirectChat(chatId)
          && request.resource.data.keys().hasAll(['senderId','senderName','text','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.text is string
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt'])
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.type == 'image'
              && request.resource.data.keys().hasOnly(['senderId','senderName','type','text','mediaId','createdAt'])
              && request.resource.data.text.size() <= 500
              && request.resource.data.mediaId is string
              && existsAfter(/databases/$(database)/documents/direct_chats/$(chatId)/media/$(request.resource.data.mediaId))
              && getAfter(/databases/$(database)/documents/direct_chats/$(chatId)/media/$(request.resource.data.mediaId)).data.kind == 'image'
              && getAfter(/databases/$(database)/documents/direct_chats/$(chatId)/media/$(request.resource.data.mediaId)).data.senderId == request.auth.uid)
            ||
            (request.resource.data.type == 'voice'
              && request.resource.data.keys().hasOnly(['senderId','senderName','type','text','mediaId','durationMs','createdAt'])
              && request.resource.data.text.size() <= 500
              && request.resource.data.mediaId is string
              && request.resource.data.durationMs is int
              && request.resource.data.durationMs > 0
              && request.resource.data.durationMs <= 65000
              && existsAfter(/databases/$(database)/documents/direct_chats/$(chatId)/media/$(request.resource.data.mediaId))
              && getAfter(/databases/$(database)/documents/direct_chats/$(chatId)/media/$(request.resource.data.mediaId)).data.kind == 'voice'
              && getAfter(/databases/$(database)/documents/direct_chats/$(chatId)/media/$(request.resource.data.mediaId)).data.senderId == request.auth.uid)
          );
        allow update, delete: if false;
      }

      match /media/{mediaId} {
        allow get: if canAccessDirectChat(chatId);
        allow list: if false;
        allow create: if canAccessDirectChat(chatId)
          && request.resource.data.keys().hasOnly(['senderId','kind','mime','data','messageId','createdAt'])
          && request.resource.data.keys().hasAll(['senderId','kind','mime','data','messageId','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.kind in ['image','voice']
          && request.resource.data.mime is string
          && request.resource.data.mime.size() <= 40
          && request.resource.data.data is string
          && request.resource.data.messageId is string
          && existsAfter(directMessagePath(chatId, request.resource.data.messageId))
          && getAfter(directMessagePath(chatId, request.resource.data.messageId)).data.senderId == request.auth.uid
          && getAfter(directMessagePath(chatId, request.resource.data.messageId)).data.type == request.resource.data.kind
          && getAfter(directMessagePath(chatId, request.resource.data.messageId)).data.mediaId == mediaId
          && ((request.resource.data.kind == 'image' && request.resource.data.data.size() <= 900000)
            || (request.resource.data.kind == 'voice' && request.resource.data.data.size() <= 600000))
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /groups/{gid} {
      allow get, list: if verified() && request.auth.uid in resource.data.memberIds;
      allow create: if verified()
        && request.resource.data.keys().hasOnly([
          'name','ownerId','adminIds','memberIds','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll([
          'name','ownerId','adminIds','memberIds','createdAt','updatedAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.adminIds == [request.auth.uid]
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 70
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if admin(gid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberIds','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 200
        && resource.data.ownerId in request.resource.data.memberIds;
      allow delete: if false;

      match /messages/{mid} {
        allow get, list: if member(gid);
        allow create: if member(gid) && validMessage();
        allow update, delete: if false;
      }
      match /join_requests/{uid} {
        allow get: if admin(gid) || myself(uid);
        allow list: if admin(gid);
        allow create: if verified() && myself(uid)
          && !(request.auth.uid in group(gid).data.memberIds)
          && request.resource.data.keys().hasOnly([
            'userId','userName','inviteCode','status','createdAt'])
          && request.resource.data.keys().hasAll([
            'userId','userName','inviteCode','status','createdAt'])
          && request.resource.data.userId == uid
          && request.resource.data.userName is string
          && request.resource.data.userName.size() <= 120
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.groupId == gid
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.active == true
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time;
        allow update: if admin(gid)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'approved'
          && uid in getAfter(/databases/$(database)/documents/groups/$(gid)).data.memberIds;
        allow delete: if false;
      }
      match /alerts/{aid} {
        allow get, list: if member(gid);
        allow create: if member(gid)
          && request.resource.data.keys().hasOnly(['senderId','senderName','lat','lng','status','createdAt'])
          && request.resource.data.keys().hasAll(['senderId','senderName','lat','lng','status','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.lat is number && request.resource.data.lng is number
          && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
          && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /announcements/{announcementId} {
        allow get, list: if member(gid);
        allow create: if admin(gid)
          && request.resource.data.keys().hasOnly(['text','senderId','senderName','createdAt'])
          && request.resource.data.keys().hasAll(['text','senderId','senderName','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow delete: if admin(gid);
        allow update: if false;
      }
      match /{other=**} { allow read, write: if false; }
    }

    match /invites/{code} {
      allow get: if verified();
      allow list: if false;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['groupId','createdBy','active','createdAt','expiresAt'])
        && request.resource.data.keys().hasAll(['groupId','createdBy','active','createdAt','expiresAt'])
        && request.resource.data.createdBy == request.auth.uid
        && admin(request.resource.data.groupId)
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(2, 'd');
      allow update, delete: if false;
    }

    // REFQA_CLOCK_TOWER_RULES_BEGIN
    // Community stores publish immediately; only unique verified users can
    // file wrong-information reports. Atomic counter+report is rule-enforced.
    match /clock_tower_places/{placeId} {
      allow get, list: if resource.data.status == 'visible';
      allow create: if verified()
        && request.resource.data.keys().hasOnly([
          'name','category','floor','unit','note','authorUid',
          'status','reportCount','createdAt'])
        && request.resource.data.keys().hasAll([
          'name','category','floor','unit','note','authorUid',
          'status','reportCount','createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.category in [
          'مطاعم','كافيهات وحلويات','تجميل','عطور','ملابس',
          'هدايا','ذهب وساعات','صيدليات وخدمات','أخرى']
        && request.resource.data.floor is int
        && request.resource.data.floor >= 1
        && request.resource.data.floor <= 7
        && request.resource.data.unit is string
        && request.resource.data.unit.size() <= 40
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.reportCount == 0
        && request.resource.data.status == 'visible'
        && request.resource.data.createdAt == request.time;
      allow update: if verified()
        && resource.data.status == 'visible'
        && resource.data.authorUid != request.auth.uid
        && resource.data.reportCount is int
        && resource.data.reportCount >= 0
        && resource.data.reportCount < 3
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reportCount','status'])
        && request.resource.data.reportCount == resource.data.reportCount + 1
        && request.resource.data.status ==
            (resource.data.reportCount == 2 ? 'hidden' : 'visible')
        && !exists(/databases/$(database)/documents/clock_tower_places/$(placeId)/reports/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/clock_tower_places/$(placeId)/reports/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/clock_tower_places/$(placeId)/reports/$(request.auth.uid)).data.reporterUid == request.auth.uid;
      allow delete: if false;

      match /reports/{uid} {
        allow get: if verified() && request.auth.uid == uid;
        allow list: if false;
        allow create: if verified()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/clock_tower_places/$(placeId)).data.status == 'visible'
          && get(/databases/$(database)/documents/clock_tower_places/$(placeId)).data.authorUid != request.auth.uid
          && request.resource.data.keys().hasOnly(['reporterUid','reason','createdAt'])
          && request.resource.data.keys().hasAll(['reporterUid','reason','createdAt'])
          && request.resource.data.reporterUid == request.auth.uid
          && request.resource.data.reason == 'wrong_information'
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/clock_tower_places/$(placeId)).data.reportCount ==
              get(/databases/$(database)/documents/clock_tower_places/$(placeId)).data.reportCount + 1
          && getAfter(/databases/$(database)/documents/clock_tower_places/$(placeId)).data.status ==
              (getAfter(/databases/$(database)/documents/clock_tower_places/$(placeId)).data.reportCount >= 3
                ? 'hidden' : 'visible');
        allow update, delete: if false;
      }
    }
    // REFQA_CLOCK_TOWER_RULES_END

    match /{path=**} { allow read, write: if false; }
  }
}
