rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function verifiedSelf(uid) { return verified() && request.auth.uid == uid; }
    function groupPath(gid) { return /databases/$(database)/documents/groups/$(gid); }
    function requestPath(gid, uid) { return /databases/$(database)/documents/groups/$(gid)/join_requests/$(uid); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    function groupFriendInvitePath(gid, uid) { return /databases/$(database)/documents/group_friend_invites/$(gid + '_' + uid); }
    function friendCodePath(code) { return /databases/$(database)/documents/friend_codes/$(code); }
    function mediaPath(gid, id) { return /databases/$(database)/documents/groups/$(gid)/media/$(id); }
    function frPath(from, to) { return /databases/$(database)/documents/friend_requests/$(from + '_' + to); }
    function member(gid) {
      return verified() && exists(groupPath(gid))
        && request.auth.uid in get(groupPath(gid)).data.memberIds;
    }
    function admin(gid) {
      return member(gid) && request.auth.uid in get(groupPath(gid)).data.adminIds;
    }
    function changedOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }
    function validPosition(d) {
      return d.lat is number && d.lng is number
        && d.lat >= -90 && d.lat <= 90
        && d.lng >= -180 && d.lng <= 180;
    }
    match /users/{uid} {
      allow get: if self(uid);
      allow list: if false;
      allow create: if self(uid)
        && request.resource.data.keys().hasAll(['displayName','email','phone','phoneVerified','countryCode','createdAt'])
        && request.resource.data.keys().hasOnly(['displayName','email','phone','phoneVerified','countryCode','createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.countryCode is string
        && request.resource.data.phoneVerified == false
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      // My pending join requests (so I can see their status before approval)
      match /join_refs/{gid} {
        allow get, list: if self(uid);
        allow create: if verifiedSelf(uid)
          && request.resource.data.keys().hasOnly(['groupName','createdAt'])
          && request.resource.data.keys().hasAll(['groupName','createdAt'])
          && request.resource.data.groupName is string
          && request.resource.data.groupName.size() <= 70
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if self(uid);
      }

      // Friends list. Both sides are written atomically when a request is accepted.
      match /friends/{fid} {
        allow get, list: if self(uid);
        allow create: if verified()
          && request.resource.data.keys().hasOnly(['name','createdAt','rid'])
          && request.resource.data.keys().hasAll(['name','createdAt','rid'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && request.resource.data.createdAt == request.time
          && (
            (request.auth.uid == uid
              && request.resource.data.rid == fid + '_' + uid
              && get(frPath(fid, uid)).data.status == 'pending'
              && getAfter(frPath(fid, uid)).data.status == 'accepted'
              && getAfter(frPath(fid, uid)).data.toUid == uid)
            ||
            (request.auth.uid == fid
              && request.resource.data.rid == uid + '_' + fid
              && get(frPath(uid, fid)).data.status == 'pending'
              && getAfter(frPath(uid, fid)).data.status == 'accepted'
              && getAfter(frPath(uid, fid)).data.toUid == fid)
          );
        allow update: if false;
        allow delete: if verified() && (request.auth.uid == uid || request.auth.uid == fid);
      }

      // Device tokens: owner-only access. Never expose tokens to other clients.
      match /fcm_tokens/{tokenId} {
        allow get, list: if verifiedSelf(uid);
        allow create, update: if verifiedSelf(uid)
          && tokenId.size() > 0 && tokenId.size() <= 2048
          && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
          && request.resource.data.keys().hasAll(['token', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token == tokenId
          && request.resource.data.updatedAt == request.time;
        allow delete: if self(uid);
      }

      match /{doc=**} { allow read, write: if false; }
    }
    match /groups/{gid} {
      allow get, list: if verified() && request.auth.uid in resource.data.memberIds;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['name','ownerId','adminIds','memberIds','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['name','ownerId','adminIds','memberIds','createdAt','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 70
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.adminIds == [request.auth.uid]
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // A user may join by ACCEPTING a verified friend-code group invitation.
      // Only the accepting user is added; ownerId/adminIds can never change here.
      allow update: if verified()
        && !(request.auth.uid in resource.data.memberIds)
        && changedOnly(['memberIds','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.size() <= 200
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.hasAll(resource.data.adminIds)
        && request.auth.uid in request.resource.data.memberIds
        && exists(groupFriendInvitePath(gid, request.auth.uid))
        && get(groupFriendInvitePath(gid, request.auth.uid)).data.status == 'pending'
        && get(groupFriendInvitePath(gid, request.auth.uid)).data.expiresAt > request.time
        && getAfter(groupFriendInvitePath(gid, request.auth.uid)).data.status == 'accepted';
      // Approval must happen atomically with marking the corresponding request approved.
      allow update: if admin(gid)
        && changedOnly(['memberIds','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && resource.data.memberIds.hasAll(resource.data.adminIds)
        && request.resource.data.memberIds.size() <= 200
        && !(request.resource.data.memberIds[request.resource.data.memberIds.size() - 1] in resource.data.memberIds)
        && exists(requestPath(gid, request.resource.data.memberIds[request.resource.data.memberIds.size() - 1]))
        && get(requestPath(gid, request.resource.data.memberIds[request.resource.data.memberIds.size() - 1])).data.status == 'pending'
        && getAfter(requestPath(gid, request.resource.data.memberIds[request.resource.data.memberIds.size() - 1])).data.status == 'approved';
      // Promote a member to admin (max 10 admins)
      allow update: if admin(gid)
        && changedOnly(['adminIds','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.adminIds is list
        && request.resource.data.adminIds.size() == resource.data.adminIds.size() + 1
        && request.resource.data.adminIds.size() <= 10
        && request.resource.data.adminIds.hasAll(resource.data.adminIds)
        && !(request.resource.data.adminIds[request.resource.data.adminIds.size() - 1] in resource.data.adminIds)
        && request.resource.data.adminIds[request.resource.data.adminIds.size() - 1] in resource.data.memberIds;
      // Admin removes exactly one member; all admins must remain
      allow update: if admin(gid)
        && changedOnly(['memberIds','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && request.resource.data.memberIds.hasAll(resource.data.adminIds);
      // A non-admin member leaves by removing only themselves
      allow update: if member(gid)
        && !(request.auth.uid in resource.data.adminIds)
        && changedOnly(['memberIds','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && !(request.auth.uid in request.resource.data.memberIds);
      allow delete: if false;

      match /join_requests/{uid} {
        allow get: if admin(gid) || self(uid);
        allow list: if admin(gid);
        allow create: if verifiedSelf(uid)
          && request.resource.data.keys().hasOnly(['userId','userName','inviteCode','status','createdAt'])
          && request.resource.data.keys().hasAll(['userId','userName','inviteCode','status','createdAt'])
          && request.resource.data.userId == uid
          && request.resource.data.userName is string
          && request.resource.data.userName.size() <= 150
          && request.resource.data.inviteCode is string
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && exists(invitePath(request.resource.data.inviteCode))
          && get(invitePath(request.resource.data.inviteCode)).data.groupId == gid
          && get(invitePath(request.resource.data.inviteCode)).data.active == true
          && get(invitePath(request.resource.data.inviteCode)).data.expiresAt > request.time
          && !(uid in get(groupPath(gid)).data.memberIds);
        // Approve (must be atomic with the group's memberIds update)
        allow update: if admin(gid)
          && resource.data.status == 'pending'
          && changedOnly(['status'])
          && request.resource.data.status == 'approved'
          && uid in getAfter(groupPath(gid)).data.memberIds
          && !(uid in get(groupPath(gid)).data.memberIds);
        // Reject (NEW)
        allow update: if admin(gid)
          && resource.data.status == 'pending'
          && changedOnly(['status'])
          && request.resource.data.status == 'rejected';
        // Admin cleanup, or the user cancelling / re-requesting after leaving or rejection
        allow delete: if admin(gid)
          || (self(uid) && !(uid in getAfter(groupPath(gid)).data.memberIds));
      }

      match /messages/{mid} {
        allow get, list: if member(gid);
        allow create: if member(gid)
          && request.resource.data.keys().hasAll(['senderId','senderName','type','text','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 150
          && request.resource.data.createdAt == request.time
          && request.resource.data.text is string
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.keys().hasOnly(['senderId','senderName','type','text','createdAt'])
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.type == 'location'
              && request.resource.data.keys().hasOnly(['senderId','senderName','type','text','lat','lng','createdAt'])
              && request.resource.data.text.size() <= 100
              && validPosition(request.resource.data))
            ||
            (request.resource.data.type == 'image'
              && request.resource.data.keys().hasOnly(['senderId','senderName','type','text','mediaId','createdAt'])
              && request.resource.data.text.size() <= 500
              && request.resource.data.mediaId is string
              && existsAfter(mediaPath(gid, request.resource.data.mediaId))
              && getAfter(mediaPath(gid, request.resource.data.mediaId)).data.kind == 'image'
              && getAfter(mediaPath(gid, request.resource.data.mediaId)).data.senderId == request.auth.uid)
            ||
            (request.resource.data.type == 'voice'
              && request.resource.data.keys().hasOnly(['senderId','senderName','type','text','mediaId','durationMs','createdAt'])
              && request.resource.data.text.size() <= 500
              && request.resource.data.mediaId is string
              && request.resource.data.durationMs is int
              && request.resource.data.durationMs > 0
              && request.resource.data.durationMs <= 125000
              && existsAfter(mediaPath(gid, request.resource.data.mediaId))
              && getAfter(mediaPath(gid, request.resource.data.mediaId)).data.kind == 'voice'
              && getAfter(mediaPath(gid, request.resource.data.mediaId)).data.senderId == request.auth.uid)
          );
        allow update: if false;
        allow delete: if member(gid)
          && (resource.data.senderId == request.auth.uid || admin(gid));
      }

      // Images and voice notes (base64, size-capped). Created together with their message.
      match /media/{id} {
        allow get: if member(gid);
        allow list: if false;
        allow create: if member(gid)
          && request.resource.data.keys().hasOnly(['senderId','kind','mime','data','createdAt'])
          && request.resource.data.keys().hasAll(['senderId','kind','mime','data','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.kind in ['image','voice']
          && request.resource.data.mime is string
          && request.resource.data.mime.size() <= 40
          && request.resource.data.data is string
          && (
            (request.resource.data.kind == 'image' && request.resource.data.data.size() <= 900000)
            ||
            (request.resource.data.kind == 'voice' && request.resource.data.data.size() <= 600000)
          )
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if member(gid)
          && (resource.data.senderId == request.auth.uid || admin(gid));
      }

      match /alerts/{aid} {
        allow get, list: if member(gid);
        allow create: if member(gid)
          && request.resource.data.keys().hasOnly(['senderId','senderName','lat','lng','status','createdAt'])
          && request.resource.data.keys().hasAll(['senderId','senderName','lat','lng','status','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 150
          && validPosition(request.resource.data)
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time;
        // Close an alert: group admin or the person who sent it (NEW)
        allow update: if member(gid)
          && (admin(gid) || resource.data.senderId == request.auth.uid)
          && resource.data.status == 'open'
          && changedOnly(['status','resolvedBy','resolvedAt'])
          && request.resource.data.status == 'resolved'
          && request.resource.data.resolvedBy == request.auth.uid
          && request.resource.data.resolvedAt == request.time;
        allow delete: if false;
      }

      // Live locations: one doc per member, writable only by its owner (NEW)
      match /locations/{uid} {
        allow get, list: if member(gid);
        allow create, update: if member(gid)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['userId','userName','lat','lng','updatedAt','expiresAt'])
          && request.resource.data.keys().hasAll(['userId','userName','lat','lng','updatedAt','expiresAt'])
          && request.resource.data.userId == uid
          && request.resource.data.userName is string
          && request.resource.data.userName.size() <= 150
          && validPosition(request.resource.data)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(9, 'h');
        allow delete: if member(gid) && (request.auth.uid == uid || admin(gid));
      }

      // Member display names (each member writes only their own doc)
      match /members/{uid} {
        allow get, list: if member(gid);
        allow create, update: if member(gid)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['userName','updatedAt'])
          && request.resource.data.keys().hasAll(['userName','updatedAt'])
          && request.resource.data.userName is string
          && request.resource.data.userName.size() <= 150
          && request.resource.data.updatedAt == request.time;
        allow delete: if member(gid) && (request.auth.uid == uid || admin(gid));
      }

      // Official announcements: admins write, members read
      match /announcements/{nid} {
        allow get, list: if member(gid);
        allow create: if admin(gid)
          && request.resource.data.keys().hasOnly(['text','senderId','senderName','createdAt'])
          && request.resource.data.keys().hasAll(['text','senderId','senderName','createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 150
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if admin(gid);
      }

      match /{other=**} { allow read, write: if false; }
    }

    // --------------------------------------------------------------
    // Group invitations using existing 8-character FRIEND codes.
    // Group CREATOR is already the owner and initial (only) admin.
    // Invites grant membership only after an explicit accept operation.
    // --------------------------------------------------------------
    match /group_friend_invites/{inviteId} {
      allow get: if verified()
        && (resource.data.toUid == request.auth.uid
            || admin(resource.data.groupId));
      allow list: if verified() && resource.data.toUid == request.auth.uid;

      allow create: if verified()
        && request.resource.data.keys().hasOnly([
          'groupId','groupName','friendCode','fromUid','fromName',
          'toUid','status','createdAt','expiresAt'])
        && request.resource.data.keys().hasAll([
          'groupId','groupName','friendCode','fromUid','fromName',
          'toUid','status','createdAt','expiresAt'])
        && request.resource.data.groupId is string
        && request.resource.data.groupId.size() > 0
        && request.resource.data.groupName is string
        && request.resource.data.groupName.size() <= 70
        && request.resource.data.friendCode is string
        && request.resource.data.friendCode.matches('[A-HJ-NP-Z2-9]{8}')
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 150
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && inviteId == request.resource.data.groupId + '_' + request.resource.data.toUid
        && admin(request.resource.data.groupId)
        && request.resource.data.groupName == get(groupPath(request.resource.data.groupId)).data.name
        && !(request.resource.data.toUid in get(groupPath(request.resource.data.groupId)).data.memberIds)
        && exists(friendCodePath(request.resource.data.friendCode))
        && get(friendCodePath(request.resource.data.friendCode)).data.uid == request.resource.data.toUid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(49, 'h');

      // Recipient can accept only by atomically joining the group,
      // or reject without joining.
      allow update: if verifiedSelf(resource.data.toUid)
        && resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && changedOnly(['status'])
        && request.resource.data.status in ['accepted', 'rejected']
        && (request.resource.data.status == 'rejected'
          || (
            !(request.auth.uid in get(groupPath(resource.data.groupId)).data.memberIds)
            && request.auth.uid in getAfter(groupPath(resource.data.groupId)).data.memberIds
          ));

      // Admin can send a new invitation after an expired/rejected invitation.
      // Fixed document ID prevents accumulating unlimited invitations per pair.
      allow update: if verified()
        && admin(resource.data.groupId)
        && (resource.data.status == 'rejected' || resource.data.expiresAt <= request.time)
        && request.time > resource.data.createdAt + duration.value(1, 'h')
        && changedOnly([
          'status','friendCode','fromUid','fromName',
          'groupName','createdAt','expiresAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 150
        && request.resource.data.groupName == get(groupPath(resource.data.groupId)).data.name
        && !(resource.data.toUid in get(groupPath(resource.data.groupId)).data.memberIds)
        && request.resource.data.friendCode is string
        && request.resource.data.friendCode.matches('[A-HJ-NP-Z2-9]{8}')
        && exists(friendCodePath(request.resource.data.friendCode))
        && get(friendCodePath(request.resource.data.friendCode)).data.uid == resource.data.toUid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(49, 'h');
      allow delete: if false;
    }

    // Friend codes: anyone verified can look up a code; each user lists only their own.
    match /friend_codes/{code} {
      allow get: if verified();
      allow list: if verified() && resource.data.uid == request.auth.uid;
      allow create: if verified()
        && code.matches('[A-HJ-NP-Z2-9]{8}')
        && request.resource.data.keys().hasOnly(['uid','displayName','createdAt'])
        && request.resource.data.keys().hasAll(['uid','displayName','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if verified() && resource.data.uid == request.auth.uid;
    }

    match /friend_requests/{rid} {
      allow get, list: if verified()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['fromUid','fromName','toUid','toName','status','createdAt'])
        && request.resource.data.keys().hasAll(['fromUid','fromName','toUid','toName','status','createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && rid == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 100
        && request.resource.data.toName is string
        && request.resource.data.toName.size() <= 100
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if verified()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && changedOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if verified()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /invites/{code} {
      // Someone holding the random code can inspect only that invite, not enumerate invites.
      allow get: if verified();
      allow list: if false;
      allow create: if verified()
        && code.matches('[A-HJ-NP-Z2-9]{12}')
        && request.resource.data.keys().hasOnly(['groupId','groupName','createdBy','active','createdAt','expiresAt'])
        && request.resource.data.keys().hasAll(['groupId','groupName','createdBy','active','createdAt','expiresAt'])
        && request.resource.data.groupId is string
        && request.resource.data.groupName is string
        && request.resource.data.groupName.size() <= 70
        && admin(request.resource.data.groupId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');
      allow update: if verified()
        && admin(resource.data.groupId)
        && changedOnly(['active'])
        && resource.data.active == true
        && request.resource.data.active == false;
      allow delete: if false;
    }

    // ==============================================
    // Private 1-to-1 chats - only confirmed friends
    // ==============================================
    function directChatPath(chatId) {
      return /databases/$(database)/documents/direct_chats/$(chatId);
    }
    function directFriendPath(uid, friendUid) {
      return /databases/$(database)/documents/users/$(uid)/friends/$(friendUid);
    }
    function areDirectFriends(a, b) {
      return a != b
        && exists(directFriendPath(a, b))
        && exists(directFriendPath(b, a));
    }
    function canAccessDirectChat(chatId) {
      let chat = get(directChatPath(chatId)).data;
      return verified()
        && chat.participantIds is list
        && chat.participantIds.size() == 2
        && request.auth.uid in chat.participantIds
        && areDirectFriends(chat.participantIds[0], chat.participantIds[1]);
    }

    match /direct_chats/{chatId} {
      allow get: if verified()
        && resource.data.participantIds is list
        && resource.data.participantIds.size() == 2
        && request.auth.uid in resource.data.participantIds
        && areDirectFriends(resource.data.participantIds[0], resource.data.participantIds[1]);
      allow list: if false;
      allow create: if verified()
        && request.resource.data.keys().hasAll(['participantIds','createdAt'])
        && request.resource.data.keys().hasOnly(['participantIds','createdAt'])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] is string
        && request.resource.data.participantIds[1] is string
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && chatId == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
        && areDirectFriends(request.resource.data.participantIds[0], request.resource.data.participantIds[1])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      // The Flutter client writes a media document and its message in one batch.
      // Rules verify both directions so an orphan or mismatched media ID is rejected.
      function directMediaPath(mediaId) {
        return /databases/$(database)/documents/direct_chats/$(chatId)/media/$(mediaId);
      }
      function directMessagePath(messageId) {
        return /databases/$(database)/documents/direct_chats/$(chatId)/messages/$(messageId);
      }
      function validDirectAttachmentMessage(d, expectedKind, mid) {
        return d.mediaId is string
          && d.mediaId.size() > 0
          && existsAfter(directMediaPath(d.mediaId))
          && getAfter(directMediaPath(d.mediaId)).data.senderId == request.auth.uid
          && getAfter(directMediaPath(d.mediaId)).data.kind == expectedKind
          && getAfter(directMediaPath(d.mediaId)).data.messageId == mid
          && getAfter(directMediaPath(d.mediaId)).data.createdAt == request.time;
      }

      match /messages/{messageId} {
        allow get, list: if canAccessDirectChat(chatId);
        allow create: if canAccessDirectChat(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 150
          && request.resource.data.text is string
          && request.resource.data.createdAt == request.time
          && (
            // Original text-only format used by FriendService.sendDirectMessage.
            (request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt'])
              && request.resource.data.keys().hasAll(['senderId','senderName','text','createdAt'])
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.keys().hasOnly(['senderId','senderName','type','text','mediaId','createdAt'])
              && request.resource.data.keys().hasAll(['senderId','senderName','type','text','mediaId','createdAt'])
              && request.resource.data.type == 'image'
              && request.resource.data.text.size() <= 500
              && validDirectAttachmentMessage(request.resource.data, 'image', messageId))
            ||
            (request.resource.data.keys().hasOnly(['senderId','senderName','type','text','mediaId','durationMs','createdAt'])
              && request.resource.data.keys().hasAll(['senderId','senderName','type','text','mediaId','durationMs','createdAt'])
              && request.resource.data.type == 'voice'
              && request.resource.data.text.size() == 0
              && request.resource.data.durationMs is int
              && request.resource.data.durationMs >= 800
              && request.resource.data.durationMs <= 65000
              && validDirectAttachmentMessage(request.resource.data, 'voice', messageId))
          );
        allow update, delete: if false;
      }

      match /media/{mediaId} {
        allow get: if canAccessDirectChat(chatId);
        allow list: if false;
        allow create: if canAccessDirectChat(chatId)
          && request.resource.data.keys().hasOnly(['senderId','kind','mime','data','messageId','createdAt'])
          && request.resource.data.keys().hasAll(['senderId','kind','mime','data','messageId','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.messageId is string
          && request.resource.data.messageId.size() > 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.data is string
          && existsAfter(directMessagePath(request.resource.data.messageId))
          && getAfter(directMessagePath(request.resource.data.messageId)).data.mediaId == mediaId
          && getAfter(directMessagePath(request.resource.data.messageId)).data.senderId == request.auth.uid
          && getAfter(directMessagePath(request.resource.data.messageId)).data.type == request.resource.data.kind
          && getAfter(directMessagePath(request.resource.data.messageId)).data.createdAt == request.time
          && (
            (request.resource.data.kind == 'image'
              && request.resource.data.mime == 'image/jpeg'
              && request.resource.data.data.size() <= 900000)
            ||
            (request.resource.data.kind == 'voice'
              && request.resource.data.mime == 'audio/mp4'
              && request.resource.data.data.size() <= 600000)
          );
        allow update, delete: if false;
      }
    }

    // REFQA_CLOCK_TOWER_RULES_BEGIN
    // Community stores publish immediately; only unique verified users can
    // file wrong-information reports. Atomic counter+report is rule-enforced.
    match /clock_tower_places/{placeId} {
      allow get, list: if resource.data.status == 'visible';
      allow create: if verified()
        && request.resource.data.keys().hasOnly([
          'name','category','floor','unit','note','authorUid',
          'status','reportCount','createdAt'])
        && request.resource.data.keys().hasAll([
          'name','category','floor','unit','note','authorUid',
          'status','reportCount','createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.category in [
          'مطاعم','كافيهات وحلويات','تجميل','عطور','ملابس',
          'هدايا','ذهب وساعات','صيدليات وخدمات','أخرى']
        && request.resource.data.floor is int
        && request.resource.data.floor >= 1
        && request.resource.data.floor <= 7
        && request.resource.data.unit is string
        && request.resource.data.unit.size() <= 40
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.reportCount == 0
        && request.resource.data.status == 'visible'
        && request.resource.data.createdAt == request.time;
      allow update: if verified()
        && resource.data.status == 'visible'
        && resource.data.authorUid != request.auth.uid
        && resource.data.reportCount is int
        && resource.data.reportCount >= 0
        && resource.data.reportCount < 3
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reportCount','status'])
        && request.resource.data.reportCount == resource.data.reportCount + 1
        && request.resource.data.status ==
            (resource.data.reportCount == 2 ? 'hidden' : 'visible')
        && !exists(/databases/$(database)/documents/clock_tower_places/$(placeId)/reports/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/clock_tower_places/$(placeId)/reports/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/clock_tower_places/$(placeId)/reports/$(request.auth.uid)).data.reporterUid == request.auth.uid;
      allow delete: if false;

      match /reports/{uid} {
        allow get: if verified() && request.auth.uid == uid;
        allow list: if false;
        allow create: if verified()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/clock_tower_places/$(placeId)).data.status == 'visible'
          && get(/databases/$(database)/documents/clock_tower_places/$(placeId)).data.authorUid != request.auth.uid
          && request.resource.data.keys().hasOnly(['reporterUid','reason','createdAt'])
          && request.resource.data.keys().hasAll(['reporterUid','reason','createdAt'])
          && request.resource.data.reporterUid == request.auth.uid
          && request.resource.data.reason == 'wrong_information'
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/clock_tower_places/$(placeId)).data.reportCount ==
              get(/databases/$(database)/documents/clock_tower_places/$(placeId)).data.reportCount + 1
          && getAfter(/databases/$(database)/documents/clock_tower_places/$(placeId)).data.status ==
              (getAfter(/databases/$(database)/documents/clock_tower_places/$(placeId)).data.reportCount >= 3
                ? 'hidden' : 'visible');
        allow update, delete: if false;
      }
    }
    // REFQA_CLOCK_TOWER_RULES_END

    // REFQA_MARKET_COMMUNITY_RULES_BEGIN
    // PUBLIC: only published, visible community contributions.
    // Create: verified user publishes at once (never gains 'verified' status).
    // Moderation: a single verified UID can report once per post. A report
    // MUST atomically increment count; the third MUST hide the post.
    match /rifqa_market_contributions/{placeId} {
      allow get, list: if resource.data.status == 'visible';
      allow create: if verified()
        && request.resource.data.keys().hasOnly([
          'name','city','placeType','category','marketId','marketName',
          'area','floor','unit','note','authorUid','status',
          'reportCount','helpfulCount','createdAt'])
        && request.resource.data.keys().hasAll([
          'name','city','placeType','category','marketId','marketName',
          'area','floor','unit','note','authorUid','status',
          'reportCount','helpfulCount','createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.city in ['makkah','madinah']
        && request.resource.data.placeType in ['shop','market']
        && request.resource.data.category in [
          'مطاعم','كافيهات وحلويات','تجميل','عطور','ملابس',
          'هدايا','ذهب وساعات','صيدليات وخدمات','أسواق شعبية','أخرى']
        && request.resource.data.marketId is string
        && request.resource.data.marketId.size() <= 80
        && request.resource.data.marketName is string
        && request.resource.data.marketName.size() <= 100
        && (request.resource.data.placeType != 'shop'
            || request.resource.data.marketName.size() > 0)
        && request.resource.data.area is string
        && request.resource.data.area.size() >= 3
        && request.resource.data.area.size() <= 180
        && request.resource.data.floor is int
        && request.resource.data.floor >= 0
        && request.resource.data.floor <= 7
        && (request.resource.data.marketId == 'makkah_clock_towers'
            || request.resource.data.floor == 0)
        && (request.resource.data.marketId != 'makkah_clock_towers'
            || (request.resource.data.city == 'makkah'
                && request.resource.data.placeType == 'shop'))
        && request.resource.data.unit is string
        && request.resource.data.unit.size() <= 40
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.status == 'visible'
        && request.resource.data.reportCount == 0
        && request.resource.data.helpfulCount == 0
        && request.resource.data.createdAt == request.time;

      // Each change can touch the relevant counter and status ONLY.
      allow update: if verified()
        && resource.data.status == 'visible'
        && request.auth.uid != resource.data.authorUid
        && (
          // One wrong-information report.
          (resource.data.reportCount is int
            && resource.data.reportCount >= 0
            && resource.data.reportCount < 3
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['reportCount','status'])
            && request.resource.data.reportCount == resource.data.reportCount + 1
            && request.resource.data.status ==
                (resource.data.reportCount == 2 ? 'hidden' : 'visible')
            && !exists(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)/reports/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)/reports/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)/reports/$(request.auth.uid)).data.reporterUid == request.auth.uid
          )
          ||
          // One helpful vote, independent of reports.
          (resource.data.helpfulCount is int
            && resource.data.helpfulCount >= 0
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['helpfulCount'])
            && request.resource.data.helpfulCount == resource.data.helpfulCount + 1
            && !exists(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)/helpful/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)/helpful/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)/helpful/$(request.auth.uid)).data.voterUid == request.auth.uid
          )
        );
      allow delete: if false;

      match /reports/{uid} {
        allow get: if verified() && request.auth.uid == uid;
        allow list: if false;
        allow create: if verified()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)).data.status == 'visible'
          && get(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)).data.authorUid != request.auth.uid
          && request.resource.data.keys().hasOnly(['reporterUid','reason','createdAt'])
          && request.resource.data.keys().hasAll(['reporterUid','reason','createdAt'])
          && request.resource.data.reporterUid == request.auth.uid
          && request.resource.data.reason == 'wrong_information'
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)).data.reportCount ==
              get(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)).data.reportCount + 1
          && getAfter(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)).data.status ==
              (getAfter(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)).data.reportCount >= 3
                ? 'hidden' : 'visible');
        allow update, delete: if false;
      }
      match /helpful/{uid} {
        allow get: if verified() && request.auth.uid == uid;
        allow list: if false;
        allow create: if verified()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)).data.status == 'visible'
          && get(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)).data.authorUid != request.auth.uid
          && request.resource.data.keys().hasOnly(['voterUid','createdAt'])
          && request.resource.data.keys().hasAll(['voterUid','createdAt'])
          && request.resource.data.voterUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)).data.helpfulCount ==
              get(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)).data.helpfulCount + 1
          && getAfter(/databases/$(database)/documents/rifqa_market_contributions/$(placeId)).data.status == 'visible';
        allow update, delete: if false;
      }
    }
    // REFQA_MARKET_COMMUNITY_RULES_END

    match /{document=**} { allow read, write: if false; }
  }
}

